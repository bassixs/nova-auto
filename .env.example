# Скопируйте в .env.local для локальной разработки. На GitHub эти значения задаются в
# Settings → Secrets and variables → Actions → Variables. Секретов здесь нет: всё попадает в код сайта.

# Адрес обработчика заявок (docs/booking-setup.md). Пусто — форма не отправляет заявки и предупреждает об этом.
VITE_BOOKING_ENDPOINT=

# Номер счётчика Яндекс Метрики. Пусто — Метрика не подключается.
VITE_YM_ID=

# Ключ JavaScript API Яндекс Карт (developer.tech.yandex.ru). Карта работает и без него.
VITE_YMAPS_KEY=
